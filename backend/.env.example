# Copia este archivo como ".env" y ajusta los valores a tu entorno local.

# Puerto en el que correrá la API
PORT=4000

# Conexión a MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_password
